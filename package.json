{
  "name": "email-scheduler-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm --workspace backend run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "dev:worker": "npm --workspace backend run worker",
    "build": "npm --workspace backend run build && npm --workspace frontend run build",
    "start": "npm --workspace backend run start:all",
    "start:backend": "npm --workspace backend run start",
    "start:worker": "npm --workspace backend run start:worker",
    "start:all": "npm --workspace backend run start:all",
    "lint": "npm --workspace backend run lint && npm --workspace frontend run lint",
    "test": "npm --workspace backend run test",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down -v"
  }
}
